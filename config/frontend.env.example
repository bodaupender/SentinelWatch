# SentinelWatch Frontend Environment Variables
# Copy to frontend/.env and customize

# Backend API URL (Vite proxy handles /api, /health, /ready, /ws in dev mode)
VITE_API_URL=http://127.0.0.1:8001

# App configuration
VITE_APP_NAME=SentinelWatch
VITE_APP_VERSION=0.1.0

# Feature flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_AI_INVESTIGATION=true
