# SentinelWatch local development settings.
# install.ps1 creates a random JWT secret in .env; never commit .env.
SW_BACKEND_SERVER__HOST=127.0.0.1
SW_BACKEND_SERVER__PORT=8001
SW_BACKEND_SERVER__DEBUG=true
SW_BACKEND_SERVER__WORKERS=1
SW_BACKEND_DATABASE__URL=sqlite+aiosqlite:///./data/sentinelwatch.db
SW_BACKEND_AUTH__JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY
SW_BACKEND_CORS__ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SW_BACKEND_AI__PROVIDER=ollama
SW_BACKEND_AI__OLLAMA_URL=http://127.0.0.1:11434
SW_BACKEND_AI__MODEL=qwen3.5:4b
